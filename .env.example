# BloodMatch v2 local development. Never copy the capstone .env here.
APP_ENV=local
APP_DEBUG=false
APP_SECURE_COOKIES=false
APP_CORS_ORIGINS=http://localhost:5180

# Separate database. Setup does not create or migrate it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bloodmatch_v2
DB_USER=root
DB_PASS=

# Empty MAIL_HOST disables SMTP delivery.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

SAFETY_AUTOMATION_ENABLED=0
EMAIL_WORKER_ENABLED=0
EMAIL_WORKER_START_AT_UTC=
MEMBERSHIP_EMAIL_ENABLED=0
MEMBERSHIP_EMAIL_START_AT_UTC=
DONATION_FOLLOWUP_ENABLED=0

# Configure NEW external encryption keys before testing private uploads.
# DOCUMENT_ENCRYPTION_MODE=dual
# DOCUMENT_KEY_DIRECTORY=C:/BloodMatchV2DocumentKeys
# DOCUMENT_ACTIVE_KEY_ID=
