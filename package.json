{
  "name": "bloodmatch",
  "version": "2.0.0-dev.0",
  "private": true,
  "description": "BloodMatch v2 development workspace",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "doctor": "node scripts/doctor.mjs",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File start-dev.ps1",
    "build": "npm --prefix frontend run build",
    "check": "node scripts/check.mjs"
  }
}
